        .compare-box {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 10px;
        }

        .compare-item {
            background-color: var(--bg-subtle);
            border: var(--border-hairline);
            border-radius: 12px;
            padding: 11px 13px;
            font-size: 12.5px;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

