            const panel = document.getElementById("labContentPanel");
            panel.innerHTML = "";

            const h = document.createElement("h3");
            h.className = "lab-panel-title";
            h.textContent = lab.title;

            const desc = document.createElement("p");
            desc.className = "lab-panel-desc";
            desc.textContent = lab.desc;

            panel.appendChild(h);
            panel.appendChild(desc);

            lab.groups.forEach(g => {
                const sec = document.createElement("div");
                sec.className = "lab-action-section";

                const lbl = document.createElement("div");
                lbl.className = "lab-action-label";
                lbl.textContent = g.label;

                const row = document.createElement("div");
                row.className = "btn-group";

                g.buttons.forEach(item => {
                    const b = document.createElement("button");
                    b.type = "button";
                    b.className = item.primary ? "btn btn-sm btn-primary" : "btn btn-sm";
                    if (item.dot) {
                        const sw = document.createElement("span");
                        sw.className = "spectrum-swatch";
                        sw.style.backgroundColor = item.dot;
                        b.appendChild(sw);
                    }
                    const tx = document.createElement("span");
                    tx.textContent = item.text;
                    b.appendChild(tx);
                    b.addEventListener("click", item.fn);
                    row.appendChild(b);
                });

                sec.appendChild(lbl);
                sec.appendChild(row);
                panel.appendChild(sec);
            });

            document.querySelectorAll("#labsTabs .lab-tab").forEach(tab => {
                const active = Number(tab.dataset.lab) === state.activeLab;
                tab.classList.toggle("active", active);
                tab.setAttribute("aria-selected", active ? "true" : "false");
            });
        }

        function syncToggleButtons() {
            const bBound = document.getElementById("btnToggleBoundary");
            bBound.classList.toggle("btn-active", state.showBoundary);
            bBound.textContent = state.showBoundary ? "✓ 90% 機率邊界" : "90% 機率邊界";

            const bSlice = document.getElementById("btnToggleSlice");
            bSlice.classList.toggle("btn-active", state.sliceMode);
            bSlice.textContent = state.sliceMode ? "✓ 剖面觀察 (開)" : "◐ 剖面觀察";

            const bRot = document.getElementById("btnToggleRotate");
            bRot.classList.toggle("btn-active", state.autoRotate);
            bRot.textContent = state.autoRotate ? "↻ 自動旋轉 (開)" : "↻ 自動旋轉 (關)";
        }

        /* =========================================================
           9. Wire All DOM Events Cleanly
           ========================================================= */
        function bindEvents() {
            // Reset all to default (Oxygen-16)
            document.getElementById("btnResetAll").addEventListener("click", () => {
                stopFillingAnimation();
                state.protons = 8;
                state.neutrons = 8;
                state.electrons = 8;
                state.viewMode = "atom";
                state.selectedN = 2;
                state.selectedL = "p";
                state.selectedOrient = "px";
                state.cloudIntensity = 0.75;
                state.zoom = 1.0;
                state.nucleusScale = 1.0;
                state.showBoundary = true;
                state.sliceMode = false;
                state.autoRotate = true;
                state.rotX = 0.34;
                state.rotY = -0.52;
                state.isExcited = false;
                state.photonAnim = null;

                document.getElementById("elementSearch").value = "";
                populateElementDropdown("");
                document.getElementById("sliderCloud").value = 75;
                document.getElementById("lblCloud").textContent = "75%";
                document.getElementById("sliderZoom").value = 100;
                document.getElementById("lblZoom").textContent = "1.0x";
                document.getElementById("sliderNucleus").value = 100;
                document.getElementById("lblNucleus").textContent = "1.0x";
                syncToggleButtons();
                setPhotonBanner("", "var(--text-tertiary)", "<strong>基態（Ground State）：</strong>已恢復為預設氧原子 ¹⁶₈O。可調整粒子或切換實驗觀察變化。");
                updateAll(true);
            });

            // Quick presets bar
            document.querySelectorAll("#quickPresetsGroup button").forEach(btn => {
                btn.addEventListener("click", () => {
                    const [p, n, e] = btn.dataset.preset.split(",").map(Number);
                    loadAtom(p, n, e, "atom");
                });
            });

            // Element search & dropdown
            document.getElementById("elementSearch").addEventListener("input", e => {
                populateElementDropdown(e.target.value);
            });

            document.getElementById("elementSelect").addEventListener("change", e => {
                const z = Number(e.target.value);
                const el = ELEMENT_MAP.get(z);
                if (!el) return;
                loadAtom(el.z, el.defaultN, el.z, "atom");
            });

            // Sliders & number inputs for Protons, Neutrons, Electrons
            function setParticle(kind, rawVal) {
                stopFillingAnimation();
                const val = Number(rawVal);
                if (Number.isNaN(val)) return;
                state.isExcited = false;
                if (kind === "p") state.protons = clamp(Math.round(val), 0, 118);
                if (kind === "n") state.neutrons = clamp(Math.round(val), 0, 180);
                if (kind === "e") state.electrons = clamp(Math.round(val), 0, 120);
                updateAll(true);
            }

            document.getElementById("sliderP").addEventListener("input", e => setParticle("p", e.target.value));
            document.getElementById("inputP").addEventListener("change", e => setParticle("p", e.target.value));
            document.getElementById("sliderN").addEventListener("input", e => setParticle("n", e.target.value));
            document.getElementById("inputN").addEventListener("change", e => setParticle("n", e.target.value));
            document.getElementById("sliderE").addEventListener("input", e => setParticle("e", e.target.value));
            document.getElementById("inputE").addEventListener("change", e => setParticle("e", e.target.value));

            document.querySelectorAll(".step-btn").forEach(btn => {
                btn.addEventListener("click", () => {
                    const [kind, deltaStr] = btn.dataset.step.split(":");
                    const delta = Number(deltaStr);
                    const cur = kind === "p" ? state.protons : kind === "n" ? state.neutrons : state.electrons;
                    setParticle(kind, cur + delta);
                });
            });

            document.getElementById("btnStdIso").addEventListener("click", () => {
                const el = ELEMENT_MAP.get(state.protons);
                if (!el) return;
                setParticle("n", el.defaultN);
            });

            document.getElementById("btnMakeNeutral").addEventListener("click", () => {
                setParticle("e", state.protons);
            });

            // 3D Viewer controls
            document.getElementById("btnModeAtom").addEventListener("click", () => {
                state.viewMode = "atom";
                updateAll(true);
            });
            document.getElementById("btnModeOrbital").addEventListener("click", () => {
                state.viewMode = "orbital";
                updateAll(true);
            });
            document.getElementById("btnToggleBoundary").addEventListener("click", () => {
                state.showBoundary = !state.showBoundary;
                syncToggleButtons();
            });
            document.getElementById("btnToggleSlice").addEventListener("click", () => {
                state.sliceMode = !state.sliceMode;
                syncToggleButtons();
            });
            document.getElementById("btnToggleRotate").addEventListener("click", () => {
                state.autoRotate = !state.autoRotate;
                syncToggleButtons();
            });
            document.getElementById("btnZoomIn").addEventListener("click", () => setZoom(state.zoom + 0.15));
            document.getElementById("btnZoomOut").addEventListener("click", () => setZoom(state.zoom - 0.15));
            document.getElementById("btnResetView").addEventListener("click", () => {
                state.rotX = 0.34;
                state.rotY = -0.52;
                setZoom(1.0);
            });

            // Visual sliders
            document.getElementById("sliderCloud").addEventListener("input", e => {
                const v = Number(e.target.value);
                state.cloudIntensity = v / 100;
                document.getElementById("lblCloud").textContent = v + "%";
            });
            document.getElementById("sliderZoom").addEventListener("input", e => {
                setZoom(Number(e.target.value) / 100);
            });
            document.getElementById("sliderNucleus").addEventListener("input", e => {
                const v = Number(e.target.value) / 100;
                state.nucleusScale = v;
                document.getElementById("lblNucleus").textContent = v.toFixed(1) + "x";
            });

            // Orbital n & l buttons
            document.querySelectorAll("#nButtonsGroup button").forEach(btn => {
                btn.addEventListener("click", () => {
                    state.selectedN = Number(btn.dataset.n);
                    state.viewMode = "orbital";
                    updateAll(true);
                });
            });
            document.querySelectorAll("#lButtonsGroup button").forEach(btn => {
                btn.addEventListener("click", () => {
                    if (btn.disabled) return;
                    state.selectedL = btn.dataset.l;
                    state.selectedOrient = ORIENTATIONS[state.selectedL][0].id;
                    state.viewMode = "orbital";
                    updateAll(true);
                });
            });

            // Filling animation & Excitation controls
            document.getElementById("btnStepDownE").addEventListener("click", () => {
                setParticle("e", state.electrons - 1);
            });
            document.getElementById("btnStepUpE").addEventListener("click", () => {
                setParticle("e", state.electrons + 1);
            });
            document.getElementById("btnPlayFill").addEventListener("click", startFillingAnimation);
            document.getElementById("btnStopFill").addEventListener("click", () => {
                stopFillingAnimation();
                if (state.electrons === 0 && state.protons > 0) {
                    state.electrons = state.protons;
                }
                updateAll(true);
            });
            document.getElementById("btnToggleExcited").addEventListener("click", triggerExcitationToggle);

            // Teaching Labs tabs
            document.querySelectorAll("#labsTabs .lab-tab").forEach(tab => {
                tab.addEventListener("click", () => {
                    state.activeLab = Number(tab.dataset.lab);
                    renderActiveLab();
                });
            });
        }

        /* =========================================================
           10. Initialization
           ========================================================= */
        function init() {
            populateElementDropdown("");
            bindEvents();
            syncToggleButtons();
            renderActiveLab();
            resizeCanvas();
            updateAll(true);
            requestAnimationFrame(renderFrame);
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", init);
        } else {
            init();
        }
    })();
    </script>
</body>
</html>
