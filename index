        /* =========================================================
           7. Filling Animation & Excitation Handlers
           ========================================================= */
        function stopFillingAnimation() {
            if (state.fillingTimer) {
                clearInterval(state.fillingTimer);
                state.fillingTimer = null;
            }
            const btn = document.getElementById("btnPlayFill");
            btn.textContent = "⏵ 逐一填入電子動畫";
        }

        function startFillingAnimation() {
            if (state.fillingTimer) {
                stopFillingAnimation();
                return;
            }
            const target = state.electrons > 0 ? state.electrons : Math.max(1, state.protons);
            state.fillingTargetE = target;
            state.isExcited = false;
            state.electrons = 0;
            updateAll(true);

            const btn = document.getElementById("btnPlayFill");
            btn.textContent = "⏸ 暫停填入動畫";

            const stepDelay = target > 36 ? 110 : target > 18 ? 190 : 320;
            state.fillingTimer = setInterval(() => {
                if (state.electrons >= state.fillingTargetE) {
                    stopFillingAnimation();
                    return;
                }
                state.electrons += 1;
                updateAll(true);
            }, stepDelay);
        }

        function triggerExcitationToggle() {
            stopFillingAnimation();
            if (state.electrons < 1) {
                setPhotonBanner("state-excited", "#F57C00", "<strong>無法激發：</strong>目前電子數為 0，請先增加至少 1 顆電子。");
                return;
            }
            state.isExcited = !state.isExcited;
            const cfg = computeConfiguration(state.protons, state.electrons, state.isExcited);
            if (state.isExcited && cfg.excitedFrom && cfg.excitedTo) {
                state.photonAnim = { type: "absorb", color: "#F57C00", progress: 0 };
                setPhotonBanner(
                    "state-excited",
                    "#F57C00",
                    `<strong>吸收能量 → 進入激發態（Excited State）：</strong>原子吸收對應能階差 ΔE 的光子，使 1 顆電子由 <strong>${cfg.excitedFrom}</strong> 躍遷至較高能階 <strong>${cfg.excitedTo}</strong>（能量升高，狀態較不穩定）。`
                );
            } else {
                state.isExcited = false;
                state.photonAnim = { type: "emit", color: "#0071E3", progress: 0 };
                setPhotonBanner(
                    "state-emit",
                    "#0071E3",
                    `<strong>放出光子 → 回到基態（Ground State）：</strong>電子由較高能階降回最低可用能階，以<strong>光子（Photon）</strong>形式釋放等於兩能階差 ΔE 的能量。`
                );
            }
            updateAll(true);
        }

        function triggerSpecificTransition(title, photonColor, msgHtml, p, n, e, excitedFlag, animType) {
            stopFillingAnimation();
            state.protons = p;
            state.neutrons = n;
            state.electrons = e;
            state.isExcited = excitedFlag;
            state.viewMode = "atom";
            state.photonAnim = { type: animType, color: photonColor, progress: 0 };
            setPhotonBanner(animType === "absorb" ? "state-excited" : "state-emit", photonColor, `<strong>${title}：</strong>${msgHtml}`);
            updateAll(true);
        }

