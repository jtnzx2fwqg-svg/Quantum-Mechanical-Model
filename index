                symCharge.style.color = "var(--color-warn)";
                idNameCn.textContent = "無法對應至週期表元素";
                idNameEn.textContent = p === 0 ? "No Element (Z = 0)" : `Unsupported Atomic Number (Z = ${p})`;
                idIsotope.textContent = p === 0
                    ? (n > 0 && e === 0 ? `目前組成：${n} 顆中子（不含質子，非化學元素）` : "目前不含質子，無法構成任何化學元素")
                    : "目前質子數超出週期表已知 1～118 號元素範圍";
                idTypeBadge.className = "status-pill pill-invalid";
                idTypeBadge.textContent = "非支援元素";
                idChargeBadge.className = "status-pill pill-invalid mono";
                idChargeBadge.textContent = `電荷：${q === 0 ? "0" : (q > 0 ? "+" + q : q)}`;
                identityNote.className = "info-callout warn";
                identityNote.textContent = "目前質子數（Z = " + p + "）無法對應至週期表 1～118 號元素。請將質子數調回 1～118 或從元素選單重新選取。";
                viewerAtomTitle.textContent = `未對應元素（Z = ${p}, A = ${A}）`;
                return;
            }

            const qStr = formatChargeText(q);
            symElement.textContent = el.sym;
            symCharge.textContent = qStr;

            const isNonDefaultIso = (n !== el.defaultN);
            const inlineNuclide = `${toSup(A)}${toSub(p)}${el.sym}${q !== 0 ? toSup(qStr.replace("−","-")) : ""}`;

            let cnTitle = "";
            let enTitle = "";

            if (q === 0) {
                cnTitle = isNonDefaultIso ? `${el.cn}同位素原子` : `${el.cn}原子`;
                enTitle = `${el.en}-${A} (Neutral Atom)`;
                symCharge.style.color = "var(--color-success)";
                idTypeBadge.className = "status-pill pill-neutral";
                idTypeBadge.textContent = "中性原子 Neutral Atom";
                idChargeBadge.className = "status-pill pill-neutral mono";
                idChargeBadge.textContent = "電荷：0";
            } else if (q > 0) {
                cnTitle = isNonDefaultIso ? `${el.cn}同位素陽離子` : `${el.cn}離子`;
                enTitle = `${el.en} ion (Cation, ${el.sym}${toSup(qStr)})`;
                symCharge.style.color = "var(--color-proton)";
                idTypeBadge.className = "status-pill pill-cation";
                idTypeBadge.textContent = "陽離子 Cation";
                idChargeBadge.className = "status-pill pill-cation mono";
                idChargeBadge.textContent = `電荷：+${q}`;
            } else {
                const anionMeta = ANION_NAMES[p];
                if (anionMeta && !isNonDefaultIso) {
                    cnTitle = anionMeta.cn;
                    enTitle = `${anionMeta.en} (Anion, ${el.sym}${toSup(qStr.replace("−","-"))})`;
                } else if (anionMeta && isNonDefaultIso) {
                    cnTitle = `${el.cn}同位素離子（${anionMeta.cn}）`;
                    enTitle = `${el.en}-${A} ${anionMeta.en}`;
                } else {
                    cnTitle = isNonDefaultIso ? `${el.cn}同位素陰離子` : `${el.cn}陰離子`;
                    enTitle = `${el.en} anion (${el.sym}${toSup(qStr.replace("−","-"))})`;
                }
                symCharge.style.color = "var(--accent-blue)";
                idTypeBadge.className = "status-pill pill-anion";
                idTypeBadge.textContent = "陰離子 Anion";
                idChargeBadge.className = "status-pill pill-anion mono";
                idChargeBadge.textContent = `電荷：${q}`;
            }

            idNameCn.textContent = cnTitle;
            idNameEn.textContent = enTitle;
            idIsotope.textContent = `同位素標記：${el.en}-${A}（${el.cn}-${A}）｜符號：${inlineNuclide}`;

            // Scientific identity explanation
            const isoStatus = el.isRad
                ? `此為放射性／人工元素，預設同位素 ${el.en}-${el.defaultA} 參考最長壽命同位素，僅供教學示意。`
                : isNonDefaultIso
                    ? `中子數已變更為 ${n}（預設常見穩定同位素為 ${el.defaultN}），元素種類維持「${el.cn}」不變，形成同位素 ${el.en}-${A}。`
                    : `目前為該元素常見同位素 ${el.en}-${A}（含 ${n} 顆中子）。`;

            const chargeStatus = q === 0
                ? `質子數與電子數相等（${p} = ${e}），呈電中性。`
                : q > 0
                    ? `電子數比質子數少 ${q} 顆（${p} − ${e} = +${q}），失去電子形成帶正電的陽離子。`
                    : `電子數比質子數多 ${Math.abs(q)} 顆（${p} − ${e} = ${q}），獲得電子形成帶負電的陰離子。`;

            identityNote.className = el.isRad ? "info-callout warn" : "info-callout";
            identityNote.textContent = `${isoStatus} ${chargeStatus}`;

            viewerAtomTitle.textContent = `${cnTitle} ${el.en}-${A}（${inlineNuclide}）`;
        }

        function renderOrbitalExplorer() {
            const n = state.selectedN;
            const l = state.selectedL;
            const validLs = ["s"];
            if (n >= 2) validLs.push("p");
            if (n >= 3) validLs.push("d");
            if (n >= 4) validLs.push("f");

            // Enforce quantum rule l < n
            if (!validLs.includes(state.selectedL)) {
                state.selectedL = validLs[validLs.length - 1];
                state.selectedOrient = ORIENTATIONS[state.selectedL][0].id;
            }

            // Sync n buttons
            document.querySelectorAll("#nButtonsGroup button").forEach(btn => {
                const bn = Number(btn.dataset.n);
                btn.classList.toggle("btn-active", bn === state.selectedN);
            });

            // Sync l buttons
            document.querySelectorAll("#lButtonsGroup button").forEach(btn => {
                const bl = btn.dataset.l;
                const allowed = validLs.includes(bl);
                btn.disabled = !allowed;
                btn.classList.toggle("btn-active", bl === state.selectedL);
            });

            // Quantum restriction hint
            const hintEl = document.getElementById("sublevelRuleHint");
            const invalidDesc =
                n === 1 ? "n = 1 僅存在 1s 次能階（1p、1d、1f 不存在）。" :
                n === 2 ? "n = 2 僅存在 2s 與 2p 次能階（2d、2f 不存在）。" :
                n === 3 ? "n = 3 存在 3s、3p、3d 三個次能階（3f 不存在）。" :
                "n = 4 完整包含 4s、4p、4d、4f 四個次能階（共 16 個軌域，最多 32 顆電子）。";
            hintEl.textContent = invalidDesc;

            // Populate orientation buttons
            const grid = document.getElementById("orientationGrid");
            grid.innerHTML = "";
            const opts = ORIENTATIONS[state.selectedL];
            if (!opts.some(o => o.id === state.selectedOrient)) {
                state.selectedOrient = opts[0].id;
            }

            opts.forEach(opt => {
                const b = document.createElement("button");
                b.type = "button";
                b.className = "btn orient-btn" + (opt.id === state.selectedOrient ? " btn-active" : "");
                b.textContent = `${state.selectedN}${opt.label}`;
                b.addEventListener("click", () => {
                    state.selectedOrient = opt.id;
                    state.viewMode = "orbital";
                    updateAll(true);
                });
                grid.appendChild(b);
            });

            // Active orbital summary
            const activeOpt = opts.find(o => o.id === state.selectedOrient) || opts[0];
            const lIdx = state.selectedL === "s" ? 0 : state.selectedL === "p" ? 1 : state.selectedL === "d" ? 2 : 3;
            const radialNodes = Math.max(0, state.selectedN - lIdx - 1);
            const shapeInfo =
                state.selectedL === "s" ? "球形對稱（Spherical），隨主能階 n 增加尺寸擴大（1s < 2s < 3s < 4s），開啟「剖面觀察」可見內部徑向節面。" :
                state.selectedL === "p" ? "雙瓣形／啞鈴形（Two-lobed），每個 p 次能階有 3 個彼此垂直的軌域（pₓ, pᵧ, p₂），最多容納 6 顆電子。" :
                state.selectedL === "d" ? "五種 d 軌域（四個四瓣形＋一個沿 z 軸雙瓣環狀 d₂²），每個 d 次能階最多容納 10 顆電子（課本不要求背誦細節形狀）。" :
                "七種複雜多瓣形 f 軌域（自 n = 4 開始出現），每個 f 次能階最多容納 14 顆電子（此 3D 圖像為角度波函數教學示意）。";

            document.getElementById("orbitalSummary").innerHTML =
                `<strong>目前選取軌域：${state.selectedN}${activeOpt.label}</strong>｜主能階 <strong>n = ${state.selectedN}</strong>、徑向節面數：<strong>${radialNodes}</strong>。${shapeInfo}`;

            // Sync viewer mode badge & toggle buttons
            document.getElementById("btnModeAtom").classList.toggle("btn-active", state.viewMode === "atom");
            document.getElementById("btnModeOrbital").classList.toggle("btn-active", state.viewMode === "orbital");
            document.getElementById("viewerModeBadge").textContent =
                state.viewMode === "atom"
                    ? "完整原子電子雲"
                    : `單一軌域 3D：${state.selectedN}${state.selectedOrient}`;
        }

