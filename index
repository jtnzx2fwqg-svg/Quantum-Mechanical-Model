                noteEl.textContent = "【重元素例外組態】已依課本 Zumdahl Fig. 11.34 套用此重元素之實驗基態組態例外。";
            } else if (cfg.noteKind === "extreme_ion" || cfg.noteKind === "heavy_approx") {
                noteEl.className = "info-callout warn";
                noteEl.textContent = "【教學近似標示】目前設定為重元素或高電荷離子，此處依能量最低原理（Aufbau）教學近似排列，部分過渡金屬／高價離子實際基態可能略有差異。";
            } else if (cfg.noteKind === "over_118") {
                noteEl.className = "info-callout warn";
                noteEl.textContent = "【超出 7p 容量上限】電子數超過 118（7p⁶ 已全滿），方框圖僅呈現至 7p⁶（118 顆電子），其餘電子超出本教材討論範圍。";
            } else {
                noteEl.textContent = "依課本填入順序 1s → 2s → 2p → 3s → 3p → 4s → 3d → 4p 排列，並嚴格遵守包立不相容原理（同軌域最多 2 顆相反自旋電子 ↑↓）與洪德定則（同能階軌域先平行單獨填入 ↑ ↑ ↑ 再配對）。";
            }

            // Excited button label sync
            const exBtn = document.getElementById("btnToggleExcited");
            if (state.isExcited) {
                exBtn.textContent = "✨ 放出光子 → 回到基態";
                exBtn.className = "btn btn-sm btn-primary";
            } else {
                exBtn.textContent = "⚡ 吸收能量 → 激發態";
                exBtn.className = "btn btn-sm btn-warn";
            }

            // Build Orbital Box Diagram (show up to highest occupied sublevel + 1 empty sublevel for clarity, min 3p)
            const track = document.getElementById("boxDiagramTrack");
            track.innerHTML = "";

            let lastOccupiedIdx = 4; // Always show at least 1s..3p (first 18 elements)
            SUBLEVELS.forEach((sub, idx) => {
                if (cfg.counts[sub.id] > 0 && idx > lastOccupiedIdx) {
                    lastOccupiedIdx = idx;
                }
            });
            const showEndIdx = Math.min(SUBLEVELS.length - 1, lastOccupiedIdx + 1);

            for (let i = 0; i <= showEndIdx; i++) {
                const sub = SUBLEVELS[i];
                const count = cfg.counts[sub.id];
                const group = document.createElement("div");
                group.className = "sublevel-group";
                if (sub.n === cfg.maxN && count > 0) group.classList.add("is-valence");
                if (state.isExcited && sub.id === cfg.excitedTo) group.classList.add("is-excited-target");

                const boxesRow = document.createElement("div");
                boxesRow.className = "sublevel-boxes";

                for (let b = 0; b < sub.boxes; b++) {
                    const box = document.createElement("div");
                    box.className = "orbital-box";
                    const hasUp = count > b;
                    const hasDown = count > (b + sub.boxes);
                    if (hasUp) {
                        box.classList.add("has-e");
                        const spUp = document.createElement("span");
                        spUp.className = "spin-up";
                        spUp.textContent = "↑";
                        box.appendChild(spUp);
                    }
                    if (hasDown) {
                        const spDn = document.createElement("span");
                        spDn.className = "spin-down";
                        spDn.textContent = "↓";
                        box.appendChild(spDn);
                    }
                    boxesRow.appendChild(box);
                }

                const lbl = document.createElement("div");
                lbl.className = "sublevel-label";
                const colMap = { s: "var(--color-s)", p: "var(--color-p)", d: "var(--color-d)", f: "var(--color-f)" };
                lbl.innerHTML = `<span style="color:${colMap[sub.l]};">${sub.id}${count > 0 ? toSup(count) : ""}</span>`;
                if (sub.n === cfg.maxN && count > 0) {
                    const tag = document.createElement("span");
                    tag.className = "sublevel-tag";
                    tag.textContent = "價";
                    lbl.appendChild(tag);
                }

                group.appendChild(boxesRow);
                group.appendChild(lbl);
                track.appendChild(group);
            }
        }

