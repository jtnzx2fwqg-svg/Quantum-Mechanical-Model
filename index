            background-color: rgba(0, 113, 227, 0.06);
        }

        .spin-up {
            color: var(--accent-blue);
        }

        .spin-down {
            color: var(--color-p);
        }

        .sublevel-label {
            font-family: var(--font-mono);
            font-size: 12px;
            font-weight: 700;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .sublevel-tag {
            font-family: var(--font-sans);
            font-size: 10px;
            font-weight: 600;
            padding: 1px 6px;
            border-radius: 999px;
            background-color: var(--bg-subcard);
            color: var(--text-secondary);
        }

        .sublevel-group.is-valence .sublevel-tag {
            background-color: var(--accent-blue-soft);
            color: var(--accent-blue);
        }

        /* =========================================================
           12. Interactive Teaching Labs (Bottom Full-Width)
           ========================================================= */
        .labs-tabs {
