<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>現代量子力學原子模型互動模擬器 | Quantum Mechanical Model</title>
    <style>
        /* =========================================================
           1. Apple HIG Design Tokens & Base Reset (Zero Dependencies)
           ========================================================= */
        :root {
            --bg-page: #F5F5F7;
            --bg-card: #FFFFFF;
            --bg-subcard: #F2F2F7;
            --bg-subtle: #F9F9FB;
            --bg-canvas: #F7F9FC;

            --text-primary: #1D1D1F;
            --text-secondary: #6E6E73;
            --text-tertiary: #86868B;

            --accent-blue: #0071E3;
            --accent-blue-hover: #0077ED;
            --accent-blue-soft: rgba(0, 113, 227, 0.10);
            --accent-blue-border: rgba(0, 113, 227, 0.28);

            --color-proton: #E53935;
            --color-proton-soft: rgba(229, 57, 53, 0.10);
            --color-neutron: #0097A7;
            --color-neutron-soft: rgba(0, 151, 167, 0.10);
            --color-electron: #0071E3;
            --color-s: #0071E3;
            --color-p: #5856D6;
            --color-d: #F57C00;
            --color-f: #9C27B0;

            --color-success: #248A3D;
            --color-success-soft: rgba(36, 138, 61, 0.10);
            --color-warn: #B25000;
            --color-warn-soft: rgba(245, 124, 0, 0.12);
            --color-danger: #C62828;
            --color-danger-soft: rgba(229, 57, 53, 0.10);

            --border-hairline: 1px solid rgba(0, 0, 0, 0.08);
            --border-strong: 1px solid rgba(0, 0, 0, 0.14);
            --shadow-card: 0 2px 12px rgba(0, 0, 0, 0.04);
            --shadow-btn: 0 1px 2px rgba(0, 0, 0, 0.05);

            --radius-card: 18px;
            --radius-sub: 12px;
            --radius-btn: 10px;
            --radius-pill: 999px;

            --font-sans: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "PingFang TC", "Noto Sans TC", "Microsoft JhengHei", sans-serif;
            --font-mono: "SF Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            max-width: 100%;
            overflow-x: hidden;
            background-color: var(--bg-page);
            color: var(--text-primary);
            font-family: var(--font-sans);
            font-size: 15px;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            text-size-adjust: 100%;
        }

        button, input, select {
            font-family: inherit;
            color: inherit;
        }

        button {
            cursor: pointer;
            touch-action: manipulation;
        }

        button:disabled {
            opacity: 0.42;
            cursor: not-allowed;
        }

        /* =========================================================
           2. Page Shell & Safe-Area Support (iPhone Safari Friendly)
           ========================================================= */
        .app-shell {
            width: 100%;
            max-width: 1440px;
            margin: 0 auto;
            padding-top: max(16px, env(safe-area-inset-top));
            padding-left: max(14px, env(safe-area-inset-left));
            padding-right: max(14px, env(safe-area-inset-right));
            padding-bottom: max(28px, env(safe-area-inset-bottom));
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        @media (min-width: 768px) {
            .app-shell {
                padding-top: max(20px, env(safe-area-inset-top));
                padding-left: max(22px, env(safe-area-inset-left));
                padding-right: max(22px, env(safe-area-inset-right));
                gap: 20px;
            }
        }

        /* =========================================================
           3. Header & Quick Presets (Normal Flow — Never Covers Content)
           ========================================================= */
        .app-header {
            background-color: var(--bg-card);
            border: var(--border-hairline);
            border-radius: var(--radius-card);
            box-shadow: var(--shadow-card);
            padding: 18px 20px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            min-width: 0;
        }

        .header-top {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
        }

        .header-brand {
            min-width: 0;
            flex: 1 1 260px;
        }

        .header-kicker {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 600;
            color: var(--accent-blue);
            background-color: var(--accent-blue-soft);
            padding: 3px 10px;
            border-radius: var(--radius-pill);
            margin-bottom: 6px;
        }

        .header-title {
            margin: 0;
            font-size: clamp(20px, 2.4vw, 26px);
            font-weight: 700;
            letter-spacing: -0.02em;
            color: var(--text-primary);
            line-height: 1.25;
            overflow-wrap: anywhere;
        }

        .header-subtitle {
            margin: 4px 0 0 0;
            font-size: 13.5px;
            color: var(--text-secondary);
            overflow-wrap: anywhere;
        }

        .header-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .presets-bar {
            padding-top: 12px;
            border-top: var(--border-hairline);
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .presets-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-secondary);
        }

        .btn-group {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            min-width: 0;
        }

        /* =========================================================
           4. Main Responsive Grid (Desktop 2-Col / Mobile 1-Col)
           ========================================================= */
        .workspace-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 20px;
            align-items: start;
        }

        @media (min-width: 1024px) {
            .workspace-grid {
                grid-template-columns: minmax(340px, 410px) minmax(0, 1fr);
            }
        }

        .col-stack {
            display: flex;
            flex-direction: column;
            gap: 20px;
            min-width: 0;
        }

        /* =========================================================
           5. Apple Card & Typography Helpers
           ========================================================= */
        .card {
            background-color: var(--bg-card);
            border: var(--border-hairline);
            border-radius: var(--radius-card);
            box-shadow: var(--shadow-card);
            padding: 18px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            min-width: 0;
        }

        @media (min-width: 768px) {
            .card {
                padding: 20px;
            }
        }

        .subcard {
            background-color: var(--bg-subtle);
            border: var(--border-hairline);
            border-radius: var(--radius-sub);
            padding: 12px 14px;
            min-width: 0;
        }

        .card-header {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            min-width: 0;
        }

        .card-title-group {
            min-width: 0;
            flex: 1 1 200px;
        }

        .card-title {
            margin: 0;
            font-size: 16.5px;
            font-weight: 700;
            letter-spacing: -0.015em;
            color: var(--text-primary);
            line-height: 1.3;
            overflow-wrap: anywhere;
        }

        .card-desc {
            margin: 3px 0 0 0;
            font-size: 12.5px;
            color: var(--text-secondary);
            overflow-wrap: anywhere;
        }

        .mono {
            font-family: var(--font-mono);
            font-variant-numeric: tabular-nums;
        }

        .wrap-text {
            overflow-wrap: anywhere;
            word-break: break-word;
        }

        /* =========================================================
           6. Buttons & Interactive Controls (Min 40px Touch Targets)
           ========================================================= */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 40px;
            padding: 8px 13px;
            border-radius: var(--radius-btn);
            border: var(--border-strong);
            background-color: var(--bg-card);
            color: var(--text-primary);
            font-size: 13px;
            font-weight: 600;
            line-height: 1.25;
            text-align: center;
            box-shadow: var(--shadow-btn);
            transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.08s ease;
            white-space: normal;
            overflow-wrap: anywhere;
        }

        .btn:hover:not(:disabled) {
            background-color: var(--bg-subcard);
        }

        .btn:active:not(:disabled) {
            transform: scale(0.98);
        }

        .btn-primary {
            background-color: var(--accent-blue);
            border-color: var(--accent-blue);
            color: #FFFFFF;
        }

        .btn-primary:hover:not(:disabled) {
            background-color: var(--accent-blue-hover);
            border-color: var(--accent-blue-hover);
        }

        .btn-soft {
            background-color: var(--bg-subcard);
            border-color: transparent;
            color: var(--text-primary);
            box-shadow: none;
        }

        .btn-soft:hover:not(:disabled) {
            background-color: #E5E5EA;
        }

        .btn-active {
            background-color: var(--accent-blue-soft);
            border-color: var(--accent-blue-border);
            color: var(--accent-blue);
        }

        .btn-active:hover:not(:disabled) {
            background-color: rgba(0, 113, 227, 0.16);
        }

        .btn-warn {
            background-color: var(--color-warn-soft);
            border-color: rgba(245, 124, 0, 0.28);
            color: var(--color-warn);
        }

        .btn-warn:hover:not(:disabled) {
            background-color: rgba(245, 124, 0, 0.20);
        }

        .btn-sm {
            min-height: 36px;
            padding: 6px 11px;
            font-size: 12.5px;
        }

        /* =========================================================
           7. Atom / Ion Identity Card (Left Col #1)
           ========================================================= */
        .identity-hero {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 14px;
            background-color: var(--bg-subtle);
            border: var(--border-hairline);
            border-radius: 14px;
            padding: 14px;
            min-width: 0;
        }

        .nuclide-badge {
            flex-shrink: 0;
            min-width: 96px;
            padding: 10px 14px;
            background-color: var(--bg-card);
            border: var(--border-strong);
            border-radius: 14px;
            box-shadow: var(--shadow-btn);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 3px;
        }

        .nuclide-left {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            justify-content: space-between;
            line-height: 1.1;
            font-family: var(--font-mono);
            font-size: 13px;
            font-weight: 700;
        }

        .nuclide-mass {
            color: var(--text-primary);
        }

        .nuclide-z {
            color: var(--color-proton);
            margin-top: 6px;
        }

        .nuclide-sym {
            font-size: 32px;
            font-weight: 700;
            line-height: 1;
            letter-spacing: -0.02em;
            color: var(--text-primary);
        }

        .nuclide-charge {
            align-self: flex-start;
            font-family: var(--font-mono);
            font-size: 14px;
            font-weight: 700;
            line-height: 1;
            margin-top: 2px;
        }

        .identity-titles {
            flex: 1 1 170px;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .identity-name-cn {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1.25;
            overflow-wrap: anywhere;
        }

        .identity-name-en {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-secondary);
            line-height: 1.3;
            overflow-wrap: anywhere;
        }

        .identity-iso-line {
            font-size: 12.5px;
            color: var(--text-secondary);
            overflow-wrap: anywhere;
        }

        .badge-row {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 4px;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: var(--radius-pill);
            font-size: 12px;
            font-weight: 600;
            line-height: 1.3;
        }

        .pill-neutral {
            background-color: var(--color-success-soft);
            color: var(--color-success);
        }

        .pill-cation {
            background-color: var(--color-proton-soft);
            color: var(--color-proton);
        }

        .pill-anion {
            background-color: var(--accent-blue-soft);
            color: var(--accent-blue);
        }

        .pill-invalid {
            background-color: var(--color-warn-soft);
            color: var(--color-warn);
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
        }

        @media (max-width: 360px) {
            .metrics-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        .metric-cell {
            background-color: var(--bg-subtle);
            border: var(--border-hairline);
            border-radius: 12px;
            padding: 9px 10px;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .metric-label {
            font-size: 11.5px;
            font-weight: 600;
            color: var(--text-secondary);
            overflow-wrap: anywhere;
        }

        .metric-value {
            font-family: var(--font-mono);
            font-size: 17px;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1.2;
        }

        .info-callout {
            background-color: var(--bg-subtle);
            border: var(--border-hairline);
            border-left: 3px solid var(--accent-blue);
            border-radius: 10px;
            padding: 10px 12px;
            font-size: 12.5px;
            color: var(--text-primary);
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .info-callout.warn {
            background-color: var(--color-warn-soft);
            border-left-color: var(--color-d);
            color: #7A3800;
        }

        /* =========================================================
           8. Element Selector & Particle Controls (Left Col #2)
           ========================================================= */
        .selector-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-width: 0;
        }

        .field-label {
            font-size: 12.5px;
            font-weight: 600;
            color: var(--text-secondary);
        }

        .apple-input, .apple-select {
            width: 100%;
            min-height: 42px;
            padding: 9px 12px;
            background-color: var(--bg-subtle);
            border: var(--border-strong);
            border-radius: var(--radius-btn);
            font-size: 14px;
            color: var(--text-primary);
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
        }

        .apple-input:focus, .apple-select:focus {
            background-color: var(--bg-card);
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.15);
        }

        @media (max-width: 768px) {
            .apple-input, .apple-select, .num-input {
                font-size: 16px;
            }
        }

        .particle-card {
            background-color: var(--bg-subtle);
            border: var(--border-hairline);
            border-radius: 14px;
            padding: 13px 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            min-width: 0;
        }

        .particle-top {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .particle-title {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 13.5px;
            font-weight: 700;
            min-width: 0;
            overflow-wrap: anywhere;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
            display: inline-block;
        }

        .stepper {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

        .step-btn {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: var(--border-strong);
            background-color: var(--bg-card);
            color: var(--text-primary);
            font-size: 18px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-btn);
        }

        .step-btn:hover {
            background-color: var(--bg-subcard);
        }

        .num-input {
            width: 66px;
            height: 40px;
            border-radius: 10px;
            border: var(--border-strong);
            background-color: var(--bg-card);
            text-align: center;
            font-family: var(--font-mono);
            font-size: 14px;
            font-weight: 700;
            outline: none;
        }

        .num-input:focus {
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.15);
        }

        .particle-footer {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            font-size: 12px;
            color: var(--text-secondary);
        }

        /* Apple-Style Touch-Friendly Range Slider */
        input[type="range"].apple-slider {
            -webkit-appearance: none;
            appearance: none;
            width: 100%;
            height: 28px;
            background: transparent;
            cursor: pointer;
            margin: 0;
        }

        input[type="range"].apple-slider:focus {
            outline: none;
        }

        input[type="range"].apple-slider::-webkit-slider-runnable-track {
            width: 100%;
            height: 6px;
            border-radius: 999px;
            background: rgba(0, 0, 0, 0.12);
        }

        input[type="range"].apple-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #FFFFFF;
            border: 1.5px solid rgba(0, 0, 0, 0.18);
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
            margin-top: -9px;
            transition: transform 0.12s ease;
        }

        input[type="range"].apple-slider::-webkit-slider-thumb:active {
            transform: scale(1.1);
        }

        input[type="range"].apple-slider::-moz-range-track {
            width: 100%;
            height: 6px;
            border-radius: 999px;
            background: rgba(0, 0, 0, 0.12);
        }

        input[type="range"].apple-slider::-moz-range-thumb {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #FFFFFF;
            border: 1.5px solid rgba(0, 0, 0, 0.18);
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
        }

        /* =========================================================
           9. 3D Atom Viewer Card (Zero Overlays on Canvas!)
           ========================================================= */
        .viewer-info-bar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            background-color: var(--bg-subtle);
            border: var(--border-hairline);
            border-radius: 12px;
            padding: 10px 14px;
            min-width: 0;
        }

        .viewer-info-main {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            min-width: 0;
        }

        .viewer-mode-tag {
            display: inline-flex;
            align-items: center;
            padding: 3px 10px;
            border-radius: var(--radius-pill);
            background-color: var(--accent-blue-soft);
            color: var(--accent-blue);
            font-size: 12px;
            font-weight: 700;
        }

        .viewer-config-chip {
            font-family: var(--font-mono);
            font-size: 12.5px;
            font-weight: 600;
            color: var(--text-primary);
            background-color: var(--bg-card);
            border: var(--border-hairline);
            padding: 3px 9px;
            border-radius: 8px;
            overflow-wrap: anywhere;
        }

        .photon-banner {
            border-radius: 12px;
            padding: 10px 14px;
            background-color: var(--bg-subtle);
            border: var(--border-hairline);
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--text-secondary);
            line-height: 1.45;
            min-width: 0;
            overflow-wrap: anywhere;
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }

        .photon-banner.state-excited {
            background-color: rgba(245, 124, 0, 0.10);
            border-color: rgba(245, 124, 0, 0.30);
            color: #7A3800;
        }

        .photon-banner.state-emit {
            background-color: rgba(0, 113, 227, 0.10);
            border-color: rgba(0, 113, 227, 0.30);
            color: #004999;
        }

        .photon-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: var(--text-tertiary);
            flex-shrink: 0;
        }

        .canvas-stage {
            width: 100%;
            height: clamp(280px, 46vw, 440px);
            background-color: var(--bg-canvas);
            border: var(--border-hairline);
            border-radius: 14px;
            overflow: hidden;
            position: relative;
        }

        .canvas-stage canvas {
            display: block;
            width: 100%;
            height: 100%;
            touch-action: none;
            cursor: grab;
        }

        .canvas-stage canvas:active {
            cursor: grabbing;
        }

        .sliders-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
        }

        .slider-box {
            background-color: var(--bg-subtle);
            border: var(--border-hairline);
            border-radius: 12px;
            padding: 10px 12px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 0;
        }

        .slider-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .slider-val {
            font-family: var(--font-mono);
            font-size: 12px;
            color: var(--accent-blue);
            font-weight: 700;
        }

        /* Collapsible Legend Block */
        details.legend-details {
            background-color: var(--bg-subtle);
            border: var(--border-hairline);
            border-radius: 12px;
            padding: 10px 14px;
        }

        details.legend-details summary {
            font-size: 13px;
